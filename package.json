{
  "name": "money-masterclass",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:css": "bunx tailwindcss -i src/styles.css -o src/app-styles.css --minify",
    "build:post": "cp -r dist/money-masterclass/browser/* dist/money-masterclass/ 2>/dev/null || true",
    "start": "bun run build:css && ng serve",
    "build": "bun install && bun run build:css && bunx ng build && bun run build:post",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "lucide-angular": "^1.0.0",
    "marked": "^18.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.1",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
